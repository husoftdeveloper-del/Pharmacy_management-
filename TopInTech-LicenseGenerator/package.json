{
  "name": "top-in-tech-license-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Offline serial-key generator for Top In Tech desktop applications",
  "author": "Top In Tech",
  "license": "UNLICENSED",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "keys": "node tools/cli.js keys",
    "new-license": "node tools/cli.js new",
    "verify": "node tools/cli.js verify",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.topintech.licensegenerator",
    "productName": "Top In Tech License Generator",
    "artifactName": "TopInTech-LicenseGenerator-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "buildResources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Top In Tech License Generator",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "TopInTech-LicenseGenerator-${version}-Portable.exe"
    }
  }
}
